{
  "entities": {
    "WashRecord": {
      "title": "WashRecord",
      "description": "Car wash record for Renazzo Auto Lab",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 50 },
        "licensePlate": { "type": "string", "maxLength": 50 },
        "vinNumber": { "type": "string", "maxLength": 50 },
        "brand": { "type": "string", "maxLength": 100 },
        "model": { "type": "string", "maxLength": 100 },
        "color": { "type": "string", "maxLength": 100 },
        "washStatus": { "type": "string", "maxLength": 100 },
        "branch": { "type": "string", "maxLength": 100 },
        "staffNames": { "type": "array" },
        "notes": { "type": "string", "maxLength": 1000 },
        "loggedBy": { "type": "string", "maxLength": 100 },
        "loggedByEmail": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["date", "brand", "washStatus", "branch", "createdAt"]
    },
    "MasterBranch": {
      "title": "MasterBranch",
      "description": "Master list of company branches",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "code": { "type": "string", "maxLength": 50 },
        "isActive": { "type": "boolean" }
      },
      "required": ["name", "code", "isActive"]
    },
    "MasterStaff": {
      "title": "MasterStaff",
      "description": "Master list of company wash and detailing staff",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "nickname": { "type": "string", "maxLength": 50 },
        "branchId": { "type": "string", "maxLength": 100 },
        "isActive": { "type": "boolean" }
      },
      "required": ["name", "isActive"]
    },
    "MasterColor": {
      "title": "MasterColor",
      "description": "Master list of car colors",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "hexCode": { "type": "string", "maxLength": 50 },
        "isDefault": { "type": "boolean" }
      },
      "required": ["name", "hexCode"]
    },
    "MasterBrand": {
      "title": "MasterBrand",
      "description": "Master list of car brands and models",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "models": { "type": "array" }
      },
      "required": ["name"]
    },
    "MasterUser": {
      "title": "MasterUser",
      "description": "Master list of registered user profiles and roles",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 100 },
        "displayName": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "maxLength": 50 }
      },
      "required": ["email", "role"]
    },
    "SystemConfig": {
      "title": "SystemConfig",
      "description": "Shared system configuration such as central Master Google Sheet ID",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "spreadsheetId": { "type": "string", "maxLength": 200 },
        "spreadsheetUrl": { "type": "string", "maxLength": 500 },
        "sheetName": { "type": "string", "maxLength": 100 },
        "updatedBy": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["spreadsheetId"]
    }
  },
  "firestore": {
    "/records/{recordId}": {
      "schema": "WashRecord",
      "description": "Real-time sync collection for car wash records"
    },
    "/master_branches/{branchId}": {
      "schema": "MasterBranch",
      "description": "Master list of branches"
    },
    "/master_staff/{staffId}": {
      "schema": "MasterStaff",
      "description": "Master list of staff"
    },
    "/master_colors/{colorId}": {
      "schema": "MasterColor",
      "description": "Master list of colors"
    },
    "/master_brands/{brandId}": {
      "schema": "MasterBrand",
      "description": "Master list of brands"
    },
    "/master_users/{userId}": {
      "schema": "MasterUser",
      "description": "Master list of users"
    },
    "/system_config/{configId}": {
      "schema": "SystemConfig",
      "description": "Shared application configuration"
    }
  }
}
