rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Car Wash Records
    match /records/{recordId} {
      allow read, write: if true;
    }

    // Master Data: Branches
    match /master_branches/{branchId} {
      allow read, write: if true;
    }

    // Master Data: Staff
    match /master_staff/{staffId} {
      allow read, write: if true;
    }

    // Master Data: Colors
    match /master_colors/{colorId} {
      allow read, write: if true;
    }

    // Master Data: Brands
    match /master_brands/{brandId} {
      allow read, write: if true;
    }

    // Master Data: User Profiles / Permissions
    match /master_users/{userId} {
      allow read, write: if true;
    }

    // Master Data: Services
    match /master_services/{serviceId} {
      allow read, write: if true;
    }

    // System Config (Shared Google Sheet ID, etc.)
    match /system_config/{configId} {
      allow read, write: if true;
    }
  }
}

